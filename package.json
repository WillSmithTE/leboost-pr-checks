{
  "name": "usero-pr-checks",
  "version": "0.6.5",
  "private": true,
  "description": "Lab web vitals for every pull request: the PR preview against main, with a significance test, as a PR comment.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "power": "esbuild scripts/power-server.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/power-server.mjs && node node_modules/.cache/power-server.mjs"
  },
  "dependencies": {
    "@actions/artifact": "6.2.1",
    "@actions/core": "3.0.1",
    "playwright-core": "1.63.0",
    "web-vitals": "6.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
